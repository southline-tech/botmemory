# Copy to .env (gitignored) and fill in. Never commit real values.
# Default storage is local under ~/.local/share/botoptimizer (or BOTOPTIMIZER_DATA_DIR).
BOTOPTIMIZER_BACKEND=local
# BOTOPTIMIZER_DATA_DIR=
BOTOPTIMIZER_ADDR=127.0.0.1:8787
# Optional bot CLI / stdio defaults:
# BOTOPTIMIZER_TOKEN_FILE=
# BOTOPTIMIZER_PROJECT=
# BOTOPTIMIZER_URL=http://127.0.0.1:8787/mcp
# Throwaway smoke vault: BOTOPTIMIZER_TEST_FOLDER=1 for bootstrap --test-folder
# BOTOPTIMIZER_TEST_FOLDER=1
# Google Drive (optional): set BOTOPTIMIZER_BACKEND=drive and:
# BOTOPTIMIZER_DRIVE_ROOT_ID=
# BOTOPTIMIZER_OAUTH_CLIENT_ID=
# BOTOPTIMIZER_OAUTH_CLIENT_SECRET=
# BOTOPTIMIZER_OAUTH_REFRESH_TOKEN=
# BOTOPTIMIZER_ACL_FILE=./acl.local.json
# BOTOPTIMIZER_LOCK_FILE=
