# Copy to .env (gitignored) and fill in. Never commit real values.
# Legacy BOTVAULT_* names are still read by the binary (with a deprecation
# warning); prefer BOTMEMORY_* going forward.
BOTMEMORY_ADDR=127.0.0.1:8787
BOTMEMORY_BACKEND=drive            # drive | memory (memory = dev only, not durable)
BOTMEMORY_DRIVE_ROOT_ID=           # id of the Drive "botMemory" folder (or legacy "botVault")
# Throwaway smoke vault: set to 1 for `botmemory bootstrap --test-folder` (folder botMemory-test)
# BOTMEMORY_TEST_FOLDER=1
# OAuth client (drive.file scope); held only by the server.
BOTMEMORY_OAUTH_CLIENT_ID=
BOTMEMORY_OAUTH_CLIENT_SECRET=
BOTMEMORY_OAUTH_REFRESH_TOKEN=
# Optional: read ACL from a local file instead of Drive _acl.json (dev/tests).
# BOTMEMORY_ACL_FILE=./acl.local.json
# Optional: single-instance lock file (default /var/tmp/botmemory-<sha256(root id)[:12]>.lock)
# BOTMEMORY_LOCK_FILE=
