# Copy to .env (gitignored) and fill in. Never commit real values.
BOTVAULT_ADDR=127.0.0.1:8787
BOTVAULT_BACKEND=drive            # drive | memory (memory = dev only, not durable)
BOTVAULT_DRIVE_ROOT_ID=           # id of Brett's Drive "botVault" folder
# OAuth client (drive.file scope) owned by Brett; held only by the server.
BOTVAULT_OAUTH_CLIENT_ID=
BOTVAULT_OAUTH_CLIENT_SECRET=
BOTVAULT_OAUTH_REFRESH_TOKEN=
# Optional: read ACL from a local file instead of Drive _acl.json (dev/tests).
# BOTVAULT_ACL_FILE=./acl.local.json
