# Copy to .env (gitignored) and fill in. Never commit real values.
# Default storage is local under ~/.local/share/botmemory (or BOTMEMORY_DATA_DIR).
BOTMEMORY_BACKEND=local
# BOTMEMORY_DATA_DIR=
BOTMEMORY_ADDR=127.0.0.1:8787
# Optional bot CLI / stdio defaults:
# BOTMEMORY_TOKEN_FILE=
# BOTMEMORY_PROJECT=
# BOTMEMORY_URL=http://127.0.0.1:8787/mcp
# Throwaway smoke vault: BOTMEMORY_TEST_FOLDER=1 for bootstrap --test-folder
# BOTMEMORY_TEST_FOLDER=1
# Google Drive (optional): set BOTMEMORY_BACKEND=drive and:
# BOTMEMORY_DRIVE_ROOT_ID=
# BOTMEMORY_OAUTH_CLIENT_ID=
# BOTMEMORY_OAUTH_CLIENT_SECRET=
# BOTMEMORY_OAUTH_REFRESH_TOKEN=
# BOTMEMORY_ACL_FILE=./acl.local.json
# BOTMEMORY_LOCK_FILE=
